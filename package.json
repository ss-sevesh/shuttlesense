{
  "name": "shuttlesense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sandbox:fix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-sandbox.ps1",
    "test:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-sandbox-fix.ps1",
    "screenshot": "playwright screenshot --channel chrome --viewport-size=1440,1000 --color-scheme light --full-page --wait-for-selector main http://127.0.0.1:3000/movement artifacts/movement-preview.png",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2"
  }
}
